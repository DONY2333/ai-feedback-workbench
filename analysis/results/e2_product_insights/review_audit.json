  "top_issue_cards": [
    {
      "issue_id": "ISS-3955d4f6ed9d",
      "product": "飞书/Lark",
      "issue_title": "消息通知未送达或通知栏显示异常",
      "product_module": "通知",
      "issue_summary": "5 条评论反映消息通知未到达、很快消失或未显示在通知栏；其中部分用户明确提到安卓设备、后台设置或手动进入应用才更新。",
      "evidence_count": 5,
      "evidence_ids": [
        "L002",
        "L003",
        "L010",
        "L016",
        "L038"
      ],
      "representative_comments": [
        {
          "feedback_id": "L002",
          "comment": "小米手机上经常收不到消息通知，即使开了保活的通知栏，给了后台无限制电源策略，给了自启动权限，在后台任务管理界面上加锁防止被清理，但还是没有消息通知，明明app还在运行，非得时不时的进去主界面看一下才会触发消息更新。实在不行就接上小米推送或者其他国内稳定一定的推送服务吧，明明是一个即时通讯软件，搞得得手动去查看有没有消息…"
        },
        {
          "feedback_id": "L003",
          "comment": "安卓手机收不到消息推送，这是即时通讯APP最基础的能力。我小米和朋友华为都是这样，基础能力不做好整天做些乱七八糟的功能，舍本逐末。市面上哪个流行的通讯APP不正常推的？"
        },
        {
          "feedback_id": "L010",
          "comment": "もう、半年以上使ってますが、通知がきません。もしくはすぐ消えます。スマホの設定、アプリの設定色々いじってもダメです。仕事で使っているので非常に困っています。"
        }
      ],
      "feedback_type_distribution": {
        "Bug": 5
      },
      "severity_distribution": {
        "高": 4,
        "中": 1
      },
      "main_user_scenarios": [],
      "core_user_pain": [
        "开启多项后台保活设置后仍经常收不到消息通知，需手动进入主界面才能触发消息更新，影响消息及时获取。",
        "安卓手机收不到消息推送，即时通讯的基础提醒能力失效",
        "通知不送达或很快消失，调整手机及应用设置后仍未解决，影响工作使用。",
        "收不到任何消息通知",
        "通知接收异常，部分通知未出现在通知栏。"
      ],
      "review_status": "evidence_checked_by_assistant",
      "review_note": "逐条核对 L002/L003/L010/L016/L038；排除 L015 音量问题；保留送达与展示子症状，不推断根因。",
      "merge_basis": "anchor",
      "rank": 1,
